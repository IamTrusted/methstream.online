---
import "../styles/global.css";
import Navbar from "../components/ui/Navbar.astro";
import Footer from "../components/ui/Footer.astro";

const SITE_NAME = import.meta.env.SITE_NAME || "SiteName";

const {
  title = "Methstreams - Best Buffstreams & Crackstreams HD Live",
  description = "Watch live sports in HD on Methstreams, the best Buffstreams & Crackstreams alternative. Stream NFL, NBA, UFC, Premier League & MLB with no signup.",
  keywords = "methstreams, buffstreams, crackstreams, methstreams alternative, best buffstreams alternative, crackstreams alternative, free live sports streaming, watch sports hd free",
  canonical = ""
} = Astro.props;

const PUBLIC_BASE_URL = (import.meta.env.PUBLIC_BASE_URL || Astro.site?.toString() || "https://methstream.online").replace(/\/$/, '');

const canonicalUrl = canonical || new URL(Astro.url.pathname, PUBLIC_BASE_URL).toString().replace(/\/$/, '') + '/';

const isPlayerPage = Astro.url.pathname.includes('/live/') || 
                     Astro.url.pathname.includes('/play') || 
                     Astro.url.pathname.startsWith('/s/');
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="theme-color" content="#080c14" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><circle cx='50' cy='50' r='48' fill='white' stroke='%23222' stroke-width='3'/><polygon points='50,18 63,28 58,44 42,44 37,28' fill='%23111'/><polygon points='50,82 37,72 42,56 58,56 63,72' fill='%23111'/><polygon points='18,39 28,28 38,35 33,50 18,50' fill='%23111'/><polygon points='82,39 72,28 62,35 67,50 82,50' fill='%23111'/><polygon points='24,65 18,50 33,50 38,65 28,72' fill='%23111'/><polygon points='76,65 82,50 67,50 62,65 72,72' fill='%23111'/></svg>" />
    <title>{title}</title>
    <meta name="robots" content="index,follow" />
    <meta itemprop="description" name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />
    <meta name="msvalidate.01" content="BFFF0110E42A5E514F0526F2D5657C78" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:video" content={canonicalUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:site" content={SITE_NAME} />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta itemprop="image" content="https://upload.wikimedia.org/wikipedia/commons/d/d3/Soccerball.svg" />
    <meta property="og:image" content="https://upload.wikimedia.org/wikipedia/commons/d/d3/Soccerball.svg" />
    <meta name="twitter:image" content="https://upload.wikimedia.org/wikipedia/commons/d/d3/Soccerball.svg" />
    
    {Astro.url.pathname === "/" && (
      <>
        <script type="application/ld+json" is:inline set:html={JSON.stringify({
          "@context": "https://schema.org",
          "@type": "WebSite",
          "name": "Methstreams",
          "alternateName": ["Buffstreams Alternative", "Crackstreams Alternative"],
          "url": PUBLIC_BASE_URL,
          "potentialAction": {
            "@type": "SearchAction",
            "target": `${PUBLIC_BASE_URL}/?q={search_term_string}`,
            "query-input": "required name=search_term_string"
          }
        })} />
        <script type="application/ld+json" is:inline set:html={JSON.stringify({
          "@context": "https://schema.org",
          "@type": "Organization",
          "name": "Methstreams",
          "alternateName": ["Buffstreams Alternative", "Crackstreams Alternative"],
          "url": PUBLIC_BASE_URL,
          "logo": "https://upload.wikimedia.org/wikipedia/commons/d/d3/Soccerball.svg",
          "sameAs": []
        })} />
      </>
    )}
    <style is:global>
      @keyframes bounce-slow {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-10px); }
      }
      .animate-bounce-slow {
        animation: bounce-slow 3s ease-in-out infinite;
      }
      .nav-link2 {
        padding: 4px 8px;
        border-radius: 6px;
        text-decoration: none;
        transition: all 0.2s ease;
      }
      .nav-link2:hover {
        background: rgba(59, 130, 246, 0.15);
      }
      .nav-link2 .text-active {
        color: #000000 !important;
        font-weight: 900 !important;
        letter-spacing: 0.02em;
      }
      .nav-link2:hover .text-active {
        color: #3b82f6 !important;
      }
      .theme-text-tertiary {
        color: #6b7280;
        opacity: 0.6;
      }
      @keyframes shimmer {
        0% { transform: translateX(-100%); }
        100% { transform: translateX(100%); }
      }
    </style>
    <script is:inline>
      // Theme permanently set to dark — no toggle
      document.documentElement.classList.remove('light');
      if (typeof localStorage !== 'undefined') {
        localStorage.setItem('theme', 'dark');
      }
    </script>
    <slot name="head" />
    
  </head>
  <body class="flex flex-col h-screen">
    <Navbar />



    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <!-- Translation Popup -->
    <div id="translate-popup" class="fixed top-20 left-4 right-4 sm:left-auto sm:right-4 sm:w-80 bg-[#1a1a1a] border border-[#333] rounded-2xl p-4 shadow-2xl z-50 hidden">
      <div class="flex items-start gap-3">
        <span class="text-2xl">🌐</span>
        <div class="flex-1">
          <p class="text-white text-sm font-semibold mb-1" id="translate-text">Translate to your language?</p>
          <p class="text-gray-400 text-xs mb-3" id="translate-subtext">Page detected in English</p>
          <div class="flex gap-2">
            <button id="translate-yes" class="flex-1 bg-[#3b82f6] hover:bg-[#2563eb] text-white text-xs font-bold py-2 px-4 rounded-full transition-colors shadow-lg shadow-blue-500/30">
              Translate
            </button>
            <button id="translate-no" class="flex-1 bg-white/10 hover:bg-white/20 text-white text-xs font-bold py-2 px-4 rounded-full transition-colors">
              No thanks
            </button>
          </div>
        </div>
        <button id="translate-close" class="text-gray-500 hover:text-white transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </div>

    <script is:inline>
      (function() {
        const langNames = {
          'es': 'Spanish', 'pt': 'Portuguese', 'fr': 'French', 'de': 'German',
          'it': 'Italian', 'ar': 'Arabic', 'hi': 'Hindi', 'ru': 'Russian',
          'ja': 'Japanese', 'ko': 'Korean', 'zh': 'Chinese', 'nl': 'Dutch',
          'pl': 'Polish', 'tr': 'Turkish', 'id': 'Indonesian', 'th': 'Thai',
          'vi': 'Vietnamese', 'sv': 'Swedish', 'da': 'Danish', 'no': 'Norwegian'
        };

        const popup = document.getElementById('translate-popup');
        const yesBtn = document.getElementById('translate-yes');
        const noBtn = document.getElementById('translate-no');
        const closeBtn = document.getElementById('translate-close');
        const translateText = document.getElementById('translate-text');

        if (!popup) return;

        // Check if user already dismissed
        if (localStorage.getItem('translate-dismissed')) return;

        // Get browser language
        const browserLang = (navigator.language || navigator.userLanguage || 'en').split('-')[0].toLowerCase();

        // If not English, show popup
        if (browserLang !== 'en' && langNames[browserLang]) {
          translateText.textContent = `Translate to ${langNames[browserLang]}?`;
          
          setTimeout(() => {
            popup.classList.remove('hidden');
            popup.classList.add('animate-slide-down');
          }, 2000);
        }

        // Translate button
        yesBtn?.addEventListener('click', () => {
          const currentUrl = window.location.href;
          const translateUrl = `https://translate.google.com/translate?sl=en&tl=${browserLang}&u=${encodeURIComponent(currentUrl)}`;
          window.open(translateUrl, '_blank');
          popup.classList.add('hidden');
          localStorage.setItem('translate-dismissed', 'true');
        });

        // No thanks button
        noBtn?.addEventListener('click', () => {
          popup.classList.add('hidden');
          localStorage.setItem('translate-dismissed', 'true');
        });

        // Close button
        closeBtn?.addEventListener('click', () => {
          popup.classList.add('hidden');
          localStorage.setItem('translate-dismissed', 'true');
        });
      })();
    </script>

    <style is:global>
      @keyframes slide-down {
        from { transform: translateY(-100%); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
      }
      .animate-slide-down {
        animation: slide-down 0.3s ease-out forwards;
      }
    </style>

    {!isPlayerPage && (
      <!-- Popunder & Social Bar (Push) Scripts (Base64 Encoded & Hidden from Search Engines) -->
      <script is:inline>
        (function() {
          try {
            var ua = (navigator.userAgent || '').toLowerCase();
            var botList = [
              'googlebot', 'bingbot', 'bingpreview', 'msnbot', 'slurp',
              'duckduckbot', 'baiduspider', 'yandex', 'sogou', 'exabot',
              'facebot', 'ia_archiver', 'crawler', 'spider', 'robot',
              'crawling', 'headless', 'mediapartners-google', 'adsbot-google'
            ];
            for (var i = 0; i < botList.length; i++) {
              if (ua.indexOf(botList[i]) !== -1) return;
            }
            if (navigator.webdriver) return;

            function injectScripts() {
              // Popunder (Full-site)
              var pop = document.createElement('script');
              pop.src = atob('aHR0cHM6Ly9wbDMxMzU2ODI3LnByb2ZpdGFibGVyYXRlY3BtbmV0d29yay5jb20vZmUvODUvMzIvZmU4NTMyYTkzMDYwMGViMzFlOWY4MWRhNWJlMTIzZGIuanM=');
              pop.async = true;
              document.body.appendChild(pop);

              // Social Bar (Push)
              var sb = document.createElement('script');
              sb.src = atob('aHR0cHM6Ly9wbDMxMzU2ODIwLnByb2ZpdGFibGVyYXRlY3BtbmV0d29yay5jb20vZDMvODkvMzIvZDM4OTMyNmVhZjI4ZWQzYjVjZTQzMzNkMzEwOTM4MTIuanM=');
              sb.async = true;
              document.body.appendChild(sb);
            }

            if (document.readyState === 'complete') {
              setTimeout(injectScripts, 1200);
            } else {
              window.addEventListener('load', function() {
                setTimeout(injectScripts, 1200);
              });
            }
          } catch (e) {}
        })();
      </script>
    )}

    <!-- Floating Discord Support Button (Bottom Right) -->
    <a
      href="https://discord.com/invite/Q2juzbcww"
      target="_blank"
      rel="noopener noreferrer"
      class="fixed bottom-5 right-5 z-40 flex items-center gap-2.5 bg-[#5865F2] hover:bg-[#4752C4] text-white px-4 py-2.5 rounded-full shadow-2xl hover:shadow-indigo-500/50 hover:scale-105 active:scale-95 transition-all duration-300 border border-white/20 group"
      aria-label="Discord Support & Live Updates"
    >
      <div class="relative flex items-center justify-center">
        <svg class="w-5 h-5 fill-current transition-transform duration-300 group-hover:rotate-12" viewBox="0 0 127.14 96.36">
          <path d="M107.7,8.07A105.15,105.15,0,0,0,81.47,0a72.06,72.06,0,0,0-3.36,6.83A97.68,97.68,0,0,0,49,6.83,72.37,72.37,0,0,0,45.64,0,105.89,105.89,0,0,0,19.39,8.09C2.79,32.65-1.71,56.6.54,80.21h0A105.73,105.73,0,0,0,32.71,96.36,77.7,77.7,0,0,0,39.6,85.25a68.42,68.42,0,0,1-10.85-5.18c.91-.66,1.8-1.34,2.66-2a75.57,75.57,0,0,0,64.32,0c.87.71,1.76,1.39,2.66,2a68.68,68.68,0,0,1-10.87,5.19,77,77,0,0,0,6.89,11.1A105.25,105.25,0,0,0,126.6,80.22h0C129.24,52.84,122.09,29.11,107.7,8.07ZM42.45,65.69C36.18,65.69,31,60,31,53s5-12.74,11.43-12.74S54,46,53.89,53,48.84,65.69,42.45,65.69Zm42.24,0C78.41,65.69,73.25,60,73.25,53s5-12.74,11.44-12.74S96.23,46,96.12,53,91.08,65.69,84.69,65.69Z"/>
        </svg>
        <span class="absolute -top-1 -right-1 flex h-2.5 w-2.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#23a55a] opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-[#23a55a] border-2 border-[#5865F2]"></span>
        </span>
      </div>
      <span class="font-bold text-xs sm:text-sm tracking-wide">Discord Support</span>
    </a>
  </body>
</html>
