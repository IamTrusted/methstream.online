---
import Layout from "../../layouts/Layout.astro";
import slugify from "../../utils/slugify";
import { fetchSports, fetchMatches, ENDPOINTS } from "../../utils/api";

export const prerender = false;

interface Props {
  brandName: string;
  logLabel: string;
  title: string;
  description: string;
  keywords: string;
  badge: string;
  h1Main: string;
  h1Highlight: string;
  heroText: string;
  ctaText: string;
  quote: string;
  platformParagraphs: string[];
  faqSchema: { name: string; text: string }[];
  faqs: { question: string; answer: string }[];
}

const {
  brandName,
  logLabel,
  title,
  description,
  keywords,
  badge,
  h1Main,
  h1Highlight,
  heroText,
  ctaText,
  quote,
  platformParagraphs,
  faqSchema,
  faqs,
} = Astro.props;

const PUBLIC_BASE_URL = (import.meta.env.PUBLIC_BASE_URL || Astro.site?.toString() || "https://methstream.online").replace(/\/$/, '');

interface APIMatch {
  id: string;
  title: string;
  category: string;
  date: number;
  popular: boolean;
  teams?: {
    home?: { name: string; badge: string };
    away?: { name: string; badge: string };
  };
}

const now = Date.now();
const fallbackFootballMatches = [
  { id: "f1", title: "Real Madrid vs Barcelona", category: "football", date: now, popular: true },
  { id: "f2", title: "Manchester United vs Liverpool", category: "football", date: now + 3600000, popular: true },
  { id: "f3", title: "Bayern Munich vs Borussia Dortmund", category: "football", date: now + 7200000, popular: true },
  { id: "f4", title: "PSG vs Marseille", category: "football", date: now + 86400000, popular: true },
];

let footballMatches: APIMatch[] = [];

try {
  const [sportsData, matchesData] = await Promise.all([fetchSports(), fetchMatches("all")]);

  if (sportsData.length > 0) {
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    const dayAfterTomorrow = new Date(today);
    dayAfterTomorrow.setDate(today.getDate() + 2);

    footballMatches = matchesData.filter((m) => {
      const matchDate = new Date(m.date);
      return m.category === "football" && matchDate >= today && matchDate < dayAfterTomorrow;
    });
  }
} catch (error) {
  console.error(`Error fetching schedule for ${logLabel}:`, error);
}

if (footballMatches.length === 0) {
  footballMatches = fallbackFootballMatches as APIMatch[];
}

const formatDateEnglish = (date: Date) => {
  const days = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
  const months = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
  return `${days[date.getDay()]}, ${months[date.getMonth()]} ${date.getDate().toString().padStart(2, "0")} - ${date.getHours().toString().padStart(2, "0")}:${date.getMinutes().toString().padStart(2, "0")}`;
};
---

<Layout title={title} description={description} keywords={keywords}>
  <slot name="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      headline: title,
      description,
      author: { "@type": "Organization", name: "Methstreams" },
      publisher: {
        "@type": "Organization",
        name: "Methstreams",
        logo: { "@type": "ImageObject", url: `${PUBLIC_BASE_URL}/favicon.svg` },
      },
      datePublished: "2026-06-16T12:00:00+00:00",
      dateModified: "2026-06-16T12:00:00+00:00",
    })} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faqSchema.map((item) => ({
        "@type": "Question",
        name: item.name,
        acceptedAnswer: { "@type": "Answer", text: item.text },
      })),
    })} />
  </slot>

  <div class="relative overflow-hidden py-16 sm:py-24 border-b border-[var(--border-color)]">
    <div class="absolute inset-0 pointer-events-none overflow-hidden">
      <div class="absolute -top-40 -left-40 w-96 h-96 bg-brand/10 rounded-full blur-[120px]"></div>
      <div class="absolute -bottom-40 -right-40 w-96 h-96 bg-brand/5 rounded-full blur-[120px]"></div>
    </div>
    <div class="max-w-5xl mx-auto px-4 text-center relative z-10">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-brand/10 border border-brand/20 text-brand text-xs font-black uppercase tracking-widest mb-6">
        {badge}
      </div>
      <h1 class="text-3xl sm:text-6xl font-black tracking-tight leading-tight uppercase italic theme-text-primary mb-6">
        {h1Main} – <span class="text-brand">{h1Highlight}</span>
      </h1>
      <p class="text-base sm:text-xl theme-text-secondary max-w-3xl mx-auto leading-relaxed mb-8">
        {heroText}
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="#live-schedule" class="w-full sm:w-auto inline-block px-8 py-4 bg-brand text-black font-black rounded-xl text-lg transition-all hover:bg-brand/90 hover:scale-105 shadow-xl">
          {ctaText} →
        </a>
        <a href="/" class="w-full sm:w-auto inline-block px-8 py-4 bg-white/5 border border-white/10 theme-text-primary font-bold rounded-xl text-lg transition-all hover:bg-white/10">
          Home Page
        </a>
      </div>
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-4 py-12">
    <div class="theme-card p-6 sm:p-8 rounded-2xl border border-white/10 mb-16">
      <p class="text-lg sm:text-xl leading-relaxed mb-0 font-semibold theme-text-secondary italic">
        "{quote}"
      </p>
    </div>

    <div class="theme-card p-6 sm:p-8 rounded-2xl border border-white/10 mb-16">
      <h2 class="text-2xl sm:text-3xl font-black uppercase tracking-wider theme-text-primary mb-6 border-b border-brand pb-4">
        About {brandName}
      </h2>
      {platformParagraphs.map((paragraph) => (
        <p class="theme-text-secondary leading-relaxed mb-4 text-base sm:text-lg last:mb-0">{paragraph}</p>
      ))}
    </div>

    <div id="live-schedule" class="mb-16 scroll-mt-20">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8 border-b border-[var(--border-color)] pb-4">
        <div>
          <h2 class="text-2xl sm:text-3xl font-black uppercase tracking-wider theme-text-primary italic">
            ⚽ Live Football <span class="text-brand">Matches</span>
          </h2>
          <p class="theme-text-secondary text-sm mt-1">Free HD streams on MethStreams — {brandName} alternative.</p>
        </div>
      </div>
      <div class="theme-card rounded-2xl p-4 sm:p-6 shadow-xl border">
        <div class="space-y-4">
          {footballMatches.map((event) => {
            const home = event.teams?.home?.name || event.title.split(" vs ")[0];
            const away = event.teams?.away?.name || event.title.split(" vs ")[1];
            const eventDate = new Date(event.date);
            const eventTimeStr = eventDate.toLocaleTimeString("en-US", { hour: "2-digit", minute: "2-digit", hour12: false });
            return (
              <a
                href={`/live/football/${slugify(event.title)}/${event.id}/`}
                class="group grid grid-cols-12 items-center theme-card transition-all rounded-xl px-4 py-5 border shadow-md gap-3 hover:border-brand/50"
              >
                <h3 class="sr-only">{home} vs {away} Live Stream</h3>
                <div class="col-span-5 flex items-center gap-3 min-w-0">
                  <span class="theme-text-primary font-black text-sm sm:text-lg truncate">{home}</span>
                </div>
                <div class="col-span-2 flex flex-col items-center">
                  <span class="text-[10px] font-black theme-text-secondary uppercase">{eventTimeStr}</span>
                  <span class="bg-brand/10 text-brand text-[9px] px-2 py-1 rounded-lg uppercase font-black mt-1 group-hover:bg-brand group-hover:text-black">Watch</span>
                </div>
                <div class="col-span-5 flex items-center justify-end min-w-0">
                  <span class="theme-text-primary font-black text-sm sm:text-lg truncate">{away}</span>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </div>

    <div class="mb-16">
      <h2 class="text-2xl sm:text-3xl font-black uppercase text-center mb-8 theme-text-primary italic">
        {brandName} <span class="text-brand">FAQ</span>
      </h2>
      <div class="max-w-4xl mx-auto space-y-4">
        {faqs.map((faq) => (
          <div class="faq-item theme-card border border-white/10 rounded-xl overflow-hidden">
            <button type="button" class="faq-question w-full flex justify-between items-center p-5 text-left font-bold theme-text-primary">
              <span>{faq.question}</span>
              <svg class="faq-icon w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </button>
            <div class="faq-answer max-h-0 overflow-hidden transition-all duration-300">
              <div class="p-5 pt-0 theme-text-secondary text-sm sm:text-base border-t border-white/5">{faq.answer}</div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="theme-card p-10 rounded-3xl border border-white/10 text-center mb-16">
      <h2 class="text-3xl font-black uppercase mb-4 theme-text-primary italic">Watch on MethStreams</h2>
      <p class="theme-text-secondary mb-8 max-w-2xl mx-auto">
        {brandName} fans get free HD soccer with backup links — same leagues, better uptime on MethStreams.
      </p>
      <a href="/" class="inline-block px-10 py-5 bg-brand text-black font-black rounded-xl text-xl hover:bg-brand/90">View All Sports</a>
    </div>
  </div>

  <script is:inline>
    document.querySelectorAll(".faq-question").forEach((q) => {
      q.addEventListener("click", () => {
        const item = q.parentElement;
        const answer = item.querySelector(".faq-answer");
        const icon = q.querySelector(".faq-icon");
        const isOpen = item.classList.contains("active");
        document.querySelectorAll(".faq-item").forEach((other) => {
          other.classList.remove("active");
          const a = other.querySelector(".faq-answer");
          const i = other.querySelector(".faq-icon");
          if (a) a.style.maxHeight = "0px";
          if (i) i.style.transform = "rotate(0deg)";
        });
        if (!isOpen && answer) {
          item.classList.add("active");
          answer.style.maxHeight = answer.scrollHeight + "px";
          if (icon) icon.style.transform = "rotate(180deg)";
        }
      });
    });
  </script>
</Layout>
