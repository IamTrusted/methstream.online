  basketball: "🏀",
  baseball: "⚾",
  hockey: "🏒",
  mma: "🥋",
  boxing: "🥊",
  tennis: "🎾",
  cricket: "🏏",
  rugby: "🏉",
  volleyball: "🏐",
  motorsports: "🏎️",
  fight: "🥊",
  american: "🏈",
  "american-football": "🏈",
  golf: "⛳",
  snooker: "🎱",
  darts: "🎯"
};

const formatDateEnglish = (date: Date) => {
  const days = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
  const months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
  
  const dayName = days[date.getDay()];
  const day = date.getDate().toString().padStart(2, '0');
  const monthName = months[date.getMonth()];
  const hours = date.getHours().toString().padStart(2, '0');
  const minutes = date.getMinutes().toString().padStart(2, '0');
  
  return `${dayName}, ${monthName} ${day} - ${hours}:${minutes}`;
};

const title = "Totalsportek Alternative - Methstreams Sports Stream";
const description = "Best Totalsportek alternative: Methstreams offers HD sports streams like Buffstreams & Crackstreams. Watch Premier League, Champions League, NFL & NBA.";
const keywords = "totalsportek alternative, methstreams, buffstreams, crackstreams, footybite alternative, free sports streaming, watch live sports free, live soccer streams";
