---
import "../../styles/global.css";
const SITE_NAME = import.meta.env.PUBLIC_SITE_NAME || "Soccer100";
export const prerender = false;
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Blogger V7 - Pages Dashboard</title>
    <meta name="robots" content="noindex, nofollow" />
    <style is:global>
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        background: #e5e7eb;
        min-height: 100vh;
        display: flex;
      }
      .sidebar {
        width: 180px;
        background: #1f2937;
        color: white;
        padding: 20px 0;
        flex-shrink: 0;
        min-height: 100vh;
      }
      .sidebar-logo {
        padding: 0 20px 20px;
        border-bottom: 1px solid #374151;
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 16px;
      }
      .sidebar-logo h1 {
        margin: 0;
        font-size: 18px;
        font-weight: 700;
      }
      .theme-toggle {
        background: #374151;
        color: white;
        border: none;
        border-radius: 6px;
        width: 30px;
        height: 30px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .sidebar-menu {
        padding: 0 8px;
      }
      .menu-item {
        padding: 10px 12px;
        display: flex;
        align-items: center;
        gap: 10px;
        color: #d1d5db;
        text-decoration: none;
        border-radius: 6px;
        font-size: 14px;
        cursor: pointer;
        margin-bottom: 2px;
      }
      .menu-item:hover { background: #374151; color: white; }
      .menu-item.active { background: #374151; color: white; }
      .main {
        flex: 1;
        padding: 24px 32px;
        overflow-x: auto;
      }
      .topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
      }
      .user-info {
        display: flex;
        gap: 8px;
        align-items: center;
      }
      .btn-danger {
        background: #fee2e2;
        color: #991b1b;
        border: 1px solid #fecaca;
        padding: 6px 14px;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
      }
      .btn-danger:hover { background: #fecaca; }
      .user-chip {
        background: white;
        border: 1px solid #e5e7eb;
        padding: 6px 14px;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 600;
        color: #374151;
      }
      .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 20px;
      }
      .page-header h2 {
        margin: 0 0 4px;
        font-size: 24px;
        font-weight: 700;
        color: #111827;
      }
      .page-header p { margin: 0; color: #6b7280; font-size: 14px; }
      .breadcrumb {
        font-size: 13px;
        color: #6b7280;
      }
      .breadcrumb a { color: #22c55e; text-decoration: none; }
      .breadcrumb a:hover { text-decoration: underline; }
      .btn-primary {
        background: #e0e7ff;
        color: #3730a3;
        border: 1px solid #c7d2fe;
        padding: 8px 16px;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
      }
      .btn-primary:hover { background: #c7d2fe; }
      .btn-secondary {
        background: white;
        color: #374151;
        border: 1px solid #d1d5db;
        padding: 8px 16px;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
      }
      .btn-secondary:hover { background: #f9fafb; }
      .sport-cards {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 20px;
        margin-bottom: 32px;
      }
      .sport-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 28px 20px;
        text-align: center;
        position: relative;
        box-shadow: 0 1px 2px rgba(0,0,0,0.04);
      }
      .sport-card .menu-dots {
        position: absolute;
        top: 12px;
        right: 12px;
        background: none;
        border: none;
        font-size: 20px;
        color: #9ca3af;
        cursor: pointer;
        padding: 0 4px;
        line-height: 1;
      }
      .sport-card .letter {
        font-size: 42px;
        font-weight: 300;
        color: #4f46e5;
        margin-bottom: 10px;
      }
      .sport-card .count {
        color: #6b7280;
        font-size: 14px;
        margin-bottom: 14px;
      }
      .sport-card .btn-copy {
        background: #e0e7ff;
        color: #3730a3;
        border: none;
        width: 100%;
        padding: 9px;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        font-size: 13px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
      }
      .sport-card .btn-copy:hover { background: #c7d2fe; }
      .toast {
        position: fixed;
        bottom: 24px;
        right: 24px;
        background: #111827;
        color: white;
        padding: 10px 16px;
        border-radius: 6px;
        font-size: 13px;
        display: none;
        z-index: 999;
      }
      .modal-bg {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.5);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 100;
      }
      .modal-bg.active { display: flex !important; }
      .modal {
        background: white !important;
        border-radius: 8px !important;
        width: 90% !important;
        max-width: 420px !important;
        min-width: 360px !important;
        padding: 24px !important;
        position: relative !important;
        box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25) !important;
        display: block !important;
        overflow: visible !important;
        box-sizing: border-box !important;
      }
      .modal > div { width: 100% !important; box-sizing: border-box !important; }
      .modal h3 { margin: 0 !important; font-size: 18px !important; color: #111827 !important; font-weight: 700 !important; }
      .modal .close-x {
        background: none !important;
        border: none !important;
        font-size: 28px !important;
        line-height: 1 !important;
        color: #6b7280 !important;
        cursor: pointer !important;
        font-weight: 300 !important;
        padding: 0 4px !important;
        height: 30px !important;
        width: 30px !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
      }
      .modal .close-x:hover { color: #111827 !important; background: #f3f4f6 !important; border-radius: 4px !important; }
      .modal label { display: block !important; font-size: 14px !important; color: #111827 !important; margin: 14px 0 6px !important; font-weight: 500 !important; }
      .modal input {
        width: 100% !important;
        padding: 10px 12px !important;
        border: 1px solid #d1d5db !important;
        border-radius: 6px !important;
        font-size: 14px !important;
        color: #111827 !important;
        background: white !important;
        box-sizing: border-box !important;
        margin: 0 0 8px !important;
      }
      .modal input::placeholder { color: #9ca3af !important; }
      .modal input:focus { outline: 2px solid #22c55e !important; outline-offset: 1px !important; border-color: #22c55e !important; }
      .modal-actions {
        display: flex !important;
        gap: 10px !important;
        justify-content: flex-end !important;
        margin-top: 16px !important;
        width: 100% !important;
        box-sizing: border-box !important;
      }
      .btn-ghost {
        background: white !important;
        border: 1px solid #d1d5db !important;
        padding: 8px 16px !important;
        border-radius: 6px !important;
        font-size: 13px !important;
        font-weight: 600 !important;
        cursor: pointer !important;
        color: #374151 !important;
      }
      .btn-ghost:hover { background: #f9fafb !important; }
      .btn-primary {
        background: #e0e7ff !important;
        color: #3730a3 !important;
        border: 1px solid #c7d2fe !important;
        padding: 8px 16px !important;
        border-radius: 6px !important;
        font-size: 13px !important;
        font-weight: 600 !important;
        cursor: pointer !important;
      }
      .btn-primary:hover { background: #c7d2fe !important; }
      .dropdown {
        position: absolute;
        top: 36px;
        right: 12px;
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 6px;
        box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1);
        min-width: 140px;
        display: none;
        z-index: 10;
      }
      .dropdown.active { display: block; }
      .dropdown button {
        display: block;
        width: 100%;
        background: none;
        border: none;
        text-align: left;
        padding: 8px 14px;
        font-size: 13px;
        color: #374151;
        cursor: pointer;
      }
      .dropdown button:hover { background: #f3f4f6; color: #991b1b; }
    </style>
  </head>
  <body>
    <div class="sidebar">
      <div class="sidebar-logo">
        <h1>Blogger V7</h1>
        <button class="theme-toggle" onclick="toggleTheme()" title="Toggle Theme">🌙</button>
      </div>
      <div class="sidebar-menu">
        <a href="/admin/dashboard" class="menu-item active">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
          Dashboard
        </a>
        <a href="/admin/ads" class="menu-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 7h20v10H2z"/><path d="M13 17v4M7 17v4M17 17v4M9 9h1M14 9h1M9 13h6"/></svg>
          Ads Placement
        </a>
      </div>
    </div>

    <div class="main">
      <div class="topbar">
        <div></div>
        <div class="user-info">
          <button class="btn-danger" onclick="deleteAllSports()">🗑 Delete All Sports</button>
          <div class="user-chip">👤 admin ▾</div>
        </div>
      </div>

      <div class="page-header">
        <div>
          <h2>Pages</h2>
          <p>Manage Blog Pages</p>
        </div>
        <div class="breadcrumb">
          <a href="/admin/dashboard">Dashboard</a>
        </div>
      </div>

      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <button class="btn-primary" onclick="openSportModal()">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v8M8 12h8"/></svg>
          Add New Sport
        </button>
        <button class="btn-secondary" onclick="alert('Sportea integration coming soon!')">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Download Schedule From Sportea
        </button>
      </div>

      <div class="sport-cards" id="sportCards"></div>
    </div>

    <div class="toast" id="toast">Copied!</div>

    <div class="modal-bg" id="sportModal" onclick="if(event.target===this)closeSportModal()">
      <div class="modal" role="dialog" aria-modal="true">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
          <h3 style="margin:0;font-size:18px;color:#111827;">Add New Sport</h3>
          <button class="close-x" onclick="closeSportModal()" aria-label="Close">×</button>
        </div>
        <div style="display:block;width:100%;">
          <label for="sportName" style="display:block;font-size:14px;color:#111827;margin-bottom:6px;">Sport Name</label>
          <input type="text" id="sportName" placeholder="Enter Sport Name" autocomplete="off" />
        </div>
        <div class="modal-actions" style="display:flex;gap:10px;justify-content:flex-end;width:100%;">
          <button class="btn-ghost" type="button" onclick="closeSportModal()">Close</button>
          <button class="btn-primary" type="button" onclick="createSport()">Add Sport</button>
        </div>
      </div>
    </div>

    <script is:inline>
      const BASE = '/api/admin';

      function toggleTheme() {
        try {
          const cur = localStorage.getItem('theme') || 'light';
          const next = cur === 'light' ? 'dark' : 'light';
          localStorage.setItem('theme', next);
          document.documentElement.classList.toggle('light', next === 'light');
        } catch(e) {}
      }

      async function checkAuth() {
        try {
          const res = await fetch('/api/admin/login.json', { credentials: 'same-origin' });
          const data = await res.json();
          if (!data.loggedIn) window.location.href = '/admin/login';
        } catch(e) { window.location.href = '/admin/login'; }
      }

      function showToast(msg) {
        const t = document.getElementById('toast');
        t.textContent = msg;
        t.style.display = 'block';
        setTimeout(() => t.style.display = 'none', 2000);
      }

      async function loadSports() {
        const res = await fetch(`${BASE}/sports.json`, { credentials: 'same-origin' });
        if (res.status === 401) { window.location.href = '/admin/login'; return; }
        const data = await res.json();
        renderSports(data.sports || []);
      }

      function renderSports(sports) {
        const wrap = document.getElementById('sportCards');
        if (sports.length === 0) {
          wrap.innerHTML = '<p style="color:#6b7280;text-align:center;grid-column:1/-1;padding:40px;">No sports yet. Click "Add New Sport" to get started.</p>';
          return;
        }
        wrap.innerHTML = sports.map(s => `
          <div class="sport-card" data-id="${s.id}">
            <button class="menu-dots" onclick="toggleDrop(event,'${s.id}')">⋮</button>
            <div class="dropdown" id="drop-${s.id}">
              <button onclick="viewSport('${s.id}')">📋 Edit Pages</button>
              <button onclick="copyLinks('${s.id}', ${s.pageCount})">🔗 Copy All Links</button>
              <button onclick="deleteSport('${s.id}')">🗑 Delete Sport</button>
            </div>
            <div class="letter">${s.id}</div>
            <div class="count">${s.pageCount || 0} Pages</div>
            <button class="btn-copy" onclick="viewSport('${s.id}')">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 16v1a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V10a2 2 0 0 1 2-2h1"/><path d="M14 4h6v6"/><path d="L10 14 20 4"/></svg>
              Copy Links
            </button>
          </div>
        `).join('');
      }

      function toggleDrop(e, id) {
        e.stopPropagation();
        document.querySelectorAll('.dropdown').forEach(d => {
          if (d.id !== `drop-${id}`) d.classList.remove('active');
        });
        document.getElementById(`drop-${id}`).classList.toggle('active');
      }
      document.addEventListener('click', () => document.querySelectorAll('.dropdown').forEach(d => d.classList.remove('active')));

      function openSportModal() { document.getElementById('sportModal').classList.add('active'); setTimeout(() => document.getElementById('sportName').focus(), 50); }
      function closeSportModal() { document.getElementById('sportModal').classList.remove('active'); document.getElementById('sportName').value = ''; }

      async function createSport() {
        const nameInput = document.getElementById('sportName');
        const name = nameInput.value.trim();
        if (!name) { showToast('❌ Please enter a Sport Name'); nameInput.focus(); return; }
        try {
          const res = await fetch(`${BASE}/sports.json`, {
            method: 'POST', credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name })
          });
          if (res.status === 401) { window.location.href = '/admin/login'; return; }
          if (!res.ok) {
            let msg = `Failed (HTTP ${res.status})`;
            try {
              const d = await res.json();
              msg = d.error || msg;
              console.error('[createSport] API error:', d);
              if (d.detail) console.error('[createSport] Stack:', d.detail);
              if (d.debug) console.error('[createSport] Debug:', d.debug);
            } catch (e) {
              console.error('[createSport] Non-JSON response, HTTP status=' + res.status, e);
              msg = `Server error (HTTP ${res.status})`;
            }
            showToast('❌ ' + msg);
            return;
          }
          closeSportModal();
          await loadSports();
          showToast('✅ Sport added!');
        } catch(e) {
          console.error('[createSport] Network error:', e);
          showToast('❌ Network error. Try again.');
        }
      }

      function viewSport(id) { window.location.href = `/admin/sport?s=${id}`; }

      async function copyLinks(id, count) {
        const res = await fetch(`${BASE}/pages.json?sportId=${id}`, { credentials: 'same-origin' });
        const data = await res.json();
        const base = window.location.origin;
        const links = (data.pages || []).map(p => `${base}/s/${p.id}`).join('\n');
        try {
          await navigator.clipboard.writeText(links);
          showToast(`Copied ${data.pages.length} links!`);
        } catch(e) {
          prompt('Copy these links:', links);
        }
      }

      async function deleteSport(id) {
        if (!confirm(`Delete sport ${id} and ALL its pages?`)) return;
        await fetch(`${BASE}/sports.json?id=${id}`, { method: 'DELETE', credentials: 'same-origin' });
        loadSports();
      }

      async function deleteAllSports() {
        if (!confirm('Delete ALL sports and ALL pages? This cannot be undone!')) return;
        await fetch(`${BASE}/sports.json`, {
          method: 'POST', credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'deleteAll' })
        });
        loadSports();
      }

      checkAuth();
      loadSports();
    </script>
  </body>
</html>
