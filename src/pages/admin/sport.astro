---
import "../../styles/global.css";
const SITE_NAME = import.meta.env.PUBLIC_SITE_NAME || "Soccer100";
export const prerender = false;
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Blogger V7 - Manage Pages</title>
    <meta name="robots" content="noindex, nofollow" />
    <style is:global>
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        background: #e5e7eb;
        min-height: 100vh;
        display: flex;
      }
      .sidebar {
        width: 180px;
        background: #1f2937;
        color: white;
        padding: 20px 0;
        flex-shrink: 0;
        min-height: 100vh;
      }
      .sidebar-logo {
        padding: 0 20px 20px;
        border-bottom: 1px solid #374151;
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 16px;
      }
      .sidebar-logo h1 { margin: 0; font-size: 18px; font-weight: 700; }
      .theme-toggle {
        background: #374151; color: white; border: none; border-radius: 6px;
        width: 30px; height: 30px; cursor: pointer;
        display: flex; align-items: center; justify-content: center;
      }
      .sidebar-menu { padding: 0 8px; }
      .menu-item {
        padding: 10px 12px;
        display: flex; align-items: center; gap: 10px;
        color: #d1d5db; text-decoration: none;
        border-radius: 6px; font-size: 14px; cursor: pointer; margin-bottom: 2px;
      }
      .menu-item:hover { background: #374151; color: white; }
      .menu-item.active { background: #374151; color: white; }
      .main {
        flex: 1; padding: 24px 32px; overflow-x: auto;
      }
      .topbar {
        display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;
      }
      .user-chip {
        background: white; border: 1px solid #e5e7eb;
        padding: 6px 14px; border-radius: 6px; font-size: 13px; font-weight: 600; color: #374151;
      }
      .page-header { margin-bottom: 20px; }
      .breadcrumb {
        font-size: 13px; color: #6b7280; text-align: right; margin-bottom: 12px;
      }
      .breadcrumb a { color: #22c55e; text-decoration: none; }
      .breadcrumb a:hover { text-decoration: underline; }
      .page-header h2 { margin: 0 0 4px; font-size: 24px; font-weight: 700; color: #111827; }
      .page-header p { margin: 0; color: #6b7280; font-size: 14px; }
      .btn-primary {
        background: #e0e7ff; color: #3730a3; border: 1px solid #c7d2fe;
        padding: 8px 16px; border-radius: 6px; font-size: 13px; font-weight: 600;
        cursor: pointer; display: inline-flex; align-items: center; gap: 6px;
      }
      .btn-primary:hover { background: #c7d2fe; }
      .btn-primary:disabled { opacity: 0.5; cursor: not-allowed; }
      .toolbar {
        display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;
        background: white; border: 1px solid #e5e7eb; border-radius: 8px 8px 0 0;
        padding: 14px 20px;
      }
      .table-wrap {
        background: white; border: 1px solid #e5e7eb; border-top: none;
        border-radius: 0 0 8px 8px; overflow-x: auto;
      }
      table {
        width: 100%; border-collapse: collapse; font-size: 14px;
      }
      thead tr { background: #334155; color: white; }
      th {
        text-align: left; padding: 12px 16px; font-weight: 600; font-size: 13px;
        text-transform: uppercase; letter-spacing: 0.03em;
      }
      td {
        padding: 14px 16px; border-bottom: 1px solid #f3f4f6; color: #1f2937;
      }
      tbody tr:last-child td { border-bottom: none; }
      tbody tr:hover { background: #f9fafb; }
      .td-num { width: 60px; color: #6b7280; font-size: 13px; }
      .td-actions { width: 260px; }
      .td-id { width: 100px; color: #6b7280; font-family: monospace; font-size: 13px; }
      .btn-copy-small {
        background: #e0e7ff; color: #3730a3; border: none;
        padding: 6px 12px; border-radius: 6px; font-weight: 600; font-size: 12px;
        cursor: pointer; display: inline-flex; align-items: center; gap: 5px;
        transition: all 0.2s ease;
      }
      .btn-copy-small:hover { background: #c7d2fe; }
      .btn-copy-small.copied-ok {
        background: #065f46 !important; color: white !important;
        box-shadow: 0 4px 12px rgba(6,95,70,0.35);
      }
      .btn-copy-small.copied-err {
        background: #991b1b !important; color: white !important;
        box-shadow: 0 4px 12px rgba(153,27,27,0.35);
      }
      .btn-edit {
        background: #d1fae5; color: #065f46; border: 1px solid #a7f3d0;
        padding: 6px 12px; border-radius: 6px; font-weight: 600; font-size: 12px;
        cursor: pointer; display: inline-flex; align-items: center; gap: 5px;
      }
      .btn-edit:hover { background: #a7f3d0; }
      .btn-delete {
        background: #fee2e2; color: #991b1b; border: 1px solid #fecaca;
        padding: 6px 12px; border-radius: 6px; font-weight: 600; font-size: 12px;
        cursor: pointer; display: inline-flex; align-items: center; gap: 5px;
      }
      .btn-delete:hover { background: #fecaca; }
      .empty {
        padding: 60px; text-align: center; color: #9ca3af;
      }
      .toast {
        position: fixed; bottom: 24px; right: 24px;
        background: #111827; color: white;
        padding: 10px 16px; border-radius: 6px; font-size: 13px; display: none; z-index: 999;
      }
      .modal-bg {
        position: fixed; inset: 0; background: rgba(0,0,0,0.5);
        display: none; align-items: center; justify-content: center; z-index: 100;
      }
      .modal-bg.active { display: flex; }
      .modal {
        background: white; border-radius: 8px; width: 90%; max-width: 420px; padding: 24px;
      }
      .modal h3 { margin: 0 0 16px; font-size: 18px; color: #111827; }
      .modal label {
        display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;
      }
      .modal input {
        width: 100%; padding: 9px 12px; border: 1px solid #d1d5db;
        border-radius: 6px; font-size: 14px; margin-bottom: 14px;
      }
      .modal-actions { display: flex; gap: 10px; justify-content: flex-end; }
      .btn-ghost {
        background: none; border: 1px solid #d1d5db; padding: 8px 16px;
        border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; color: #374151;
      }
    </style>
  </head>
  <body>
    <div class="sidebar">
      <div class="sidebar-logo">
        <h1>Blogger V7</h1>
        <button class="theme-toggle" onclick="toggleTheme()">🌙</button>
      </div>
      <div class="sidebar-menu">
        <a href="/admin/dashboard" class="menu-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
          Dashboard
        </a>
        <a href="/admin/ads" class="menu-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 7h20v10H2z"/><path d="M13 17v4M7 17v4M17 17v4M9 9h1M14 9h1M9 13h6"/></svg>
          Ads Placement
        </a>
      </div>
    </div>

    <div class="main">
      <div class="topbar">
        <div></div>
        <div class="user-chip">👤 admin ▾</div>
      </div>

      <div class="breadcrumb">
        <a href="/admin/dashboard">Dashboard</a> > <span id="crumbSport">S</span>
      </div>
      <div class="page-header">
        <h2 id="sportNameH2">S</h2>
        <p>Pages in this category</p>
      </div>

      <div class="toolbar">
        <button class="btn-primary" onclick="openGameModal()">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
          Add New Game
        </button>
        <button class="btn-primary" onclick="openBulkModal()">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v8M8 12h8"/></svg>
          Make New Pages
        </button>
        <div style="color:#6b7280;font-size:13px;">
          Total: <strong id="pageCount">0</strong> pages
        </div>
      </div>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>#</th>
              <th>Title</th>
              <th>Copy</th>
              <th>Edit</th>
            </tr>
          </thead>
          <tbody id="pagesBody">
          </tbody>
        </table>
        <div class="empty" id="emptyState" style="display:none;">No pages yet. Click "Add New Game" or "Make New Pages" to create pages.</div>
      </div>
    </div>

    <div class="toast" id="toast">Done!</div>

    <div class="modal-bg" id="gameModal">
      <div class="modal">
        <h3>Add New Game</h3>
        <label>Game Title (optional)</label>
        <input type="text" id="gameTitle" placeholder="e.g. Man Utd vs Liverpool Live Stream" autocomplete="off" />
        <label>Iframe URL (optional)</label>
        <input type="text" id="gameIframe" placeholder="https://example.com/embed/..." autocomplete="off" />
        <div class="modal-actions">
          <button class="btn-ghost" onclick="closeGameModal()">Cancel</button>
          <button class="btn-primary" onclick="createGame()">Create Game</button>
        </div>
      </div>
    </div>

    <div class="modal-bg" id="bulkModal">
      <div class="modal">
        <h3>Make New Pages</h3>
        <label>Number of pages to create</label>
        <input type="number" id="pageCountInput" value="10" min="1" max="500" />
        <div class="modal-actions">
          <button class="btn-ghost" onclick="closeBulkModal()">Cancel</button>
          <button class="btn-primary" onclick="bulkCreate()">Create Pages</button>
        </div>
      </div>
    </div>

    <script is:inline>
      const BASE = '/api/admin';
      const params = new URLSearchParams(window.location.search);
      const SPORT_ID = params.get('s') || 'S';

      function toggleTheme() {
        try {
          const cur = localStorage.getItem('theme') || 'light';
          const next = cur === 'light' ? 'dark' : 'light';
          localStorage.setItem('theme', next);
          document.documentElement.classList.toggle('light', next === 'light');
        } catch(e) {}
      }

      async function checkAuth() {
        try {
          const res = await fetch('/api/admin/login.json', { credentials: 'same-origin' });
          const data = await res.json();
          if (!data.loggedIn) window.location.href = '/admin/login';
        } catch(e) { window.location.href = '/admin/login'; }
      }

      function showToast(msg) {
        const t = document.getElementById('toast');
        t.textContent = msg;
        t.style.display = 'block';
        setTimeout(() => t.style.display = 'none', 2000);
      }

      document.getElementById('crumbSport').textContent = SPORT_ID;
      document.getElementById('sportNameH2').textContent = SPORT_ID;

      async function loadPages() {
        const res = await fetch(`${BASE}/pages.json?sportId=${SPORT_ID}`, { credentials: 'same-origin' });
        if (res.status === 401) { window.location.href = '/admin/login'; return; }
        const data = await res.json();
        renderPages(data.pages || []);
      }

      function renderPages(pages) {
        const body = document.getElementById('pagesBody');
        document.getElementById('pageCount').textContent = pages.length;
        if (pages.length === 0) {
          body.innerHTML = '';
          document.getElementById('emptyState').style.display = 'block';
          return;
        }
        document.getElementById('emptyState').style.display = 'none';
        body.innerHTML = pages.map((p, i) => `
          <tr>
            <td class="td-num">${i + 1}</td>
            <td>
              <div style="font-weight:500;">${escapeHtml(p.title)}</div>
              <div style="font-size:11px;color:#9ca3af;margin-top:2px;font-family:monospace;">${p.id}</div>
            </td>
            <td><button class="btn-copy-small" onclick="copyLink('${p.id}')">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 16v1a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V10a2 2 0 0 1 2-2h1"/><path d="M14 4h6v6"/><path d="L10 14 20 4"/></svg>
              Copy : ${p.id}
            </button></td>
            <td><button class="btn-edit" onclick="editPage('${p.id}')">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
              Edit : ${p.id}
            </button></td>
          </tr>
        `).join('');
      }

      function escapeHtml(s) {
        const d = document.createElement('div');
        d.textContent = s;
        return d.innerHTML;
      }

      async function copyLink(id) {
        const url = `${window.location.origin}/s/${id}`;
        const btn = event ? event.currentTarget : document.querySelector(`[onclick*="copyLink('${id}')"]`);
        const originalHTML = btn ? btn.innerHTML : null;
        const originalText = `Copy : ${id}`;
        const iconSVG = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 16v1a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V10a2 2 0 0 1 2-2h1"/><path d="M14 4h6v6"/><path d="L10 14 20 4"/></svg>';
        try {
          await navigator.clipboard.writeText(url);
          if (btn) {
            btn.classList.remove('copied-err');
            btn.classList.add('copied-ok');
            btn.innerHTML = `✅ Copied!`;
            setTimeout(() => {
              btn.classList.remove('copied-ok');
              btn.innerHTML = originalHTML || `${iconSVG} ${originalText}`;
            }, 1800);
          }
          showToast(`✅ Copied: ${url}`);
        } catch(e) {
          if (btn) {
            btn.classList.remove('copied-ok');
            btn.classList.add('copied-err');
            btn.innerHTML = `❌ Failed`;
            setTimeout(() => {
              btn.classList.remove('copied-err');
              btn.innerHTML = originalHTML || `${iconSVG} ${originalText}`;
            }, 1800);
          }
          try { prompt('Copy this link manually:', url); } catch(_) {}
        }
      }

      function editPage(id) {
        window.location.href = `/admin/edit?page=${id}&s=${SPORT_ID}`;
      }

      function openGameModal() {
        document.getElementById('gameModal').classList.add('active');
        setTimeout(() => document.getElementById('gameTitle').focus(), 50);
      }
      function closeGameModal() {
        document.getElementById('gameModal').classList.remove('active');
        document.getElementById('gameTitle').value = '';
        document.getElementById('gameIframe').value = '';
      }

      async function createGame() {
        const titleInput = document.getElementById('gameTitle');
        const iframeInput = document.getElementById('gameIframe');
        const title = titleInput.value.trim();
        const iframe = iframeInput.value.trim();
        const btn = event ? event.target : null;
        if (btn) {
          btn.disabled = true;
          const origText = btn.innerHTML;
          btn.innerHTML = '⏳ Creating...';
        }
        try {
          const res = await fetch(`${BASE}/pages.json`, {
            method: 'POST', credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ sportId: SPORT_ID, title, iframe })
          });
          if (res.status === 401) { window.location.href = '/admin/login'; return; }
          if (!res.ok) {
            let msg = `Failed (HTTP ${res.status})`;
            try {
              const d = await res.json();
              msg = d.error || msg;
              console.error('[createGame] API error:', d);
              if (d.detail) console.error('[createGame] Stack:', d.detail);
            } catch (e) {
              console.error('[createGame] Non-JSON response, HTTP status=' + res.status, e);
              msg = `Server error (HTTP ${res.status})`;
            }
            if (btn) { btn.disabled = false; btn.innerHTML = origText; }
            showToast('❌ ' + msg);
            return;
          }
          if (btn) { btn.disabled = false; btn.innerHTML = origText; }
          closeGameModal();
          await loadPages();
          showToast('✅ Game created!');
        } catch(e) {
          console.error('[createGame] Network error:', e);
          if (btn) { btn.disabled = false; btn.innerHTML = origText; }
          showToast('❌ Network error. Try again.');
        }
      }

      function openBulkModal() {
        document.getElementById('bulkModal').classList.add('active');
        document.getElementById('pageCountInput').focus();
      }
      function closeBulkModal() {
        document.getElementById('bulkModal').classList.remove('active');
      }

      async function bulkCreate() {
        const countInput = document.getElementById('pageCountInput');
        const count = parseInt(countInput.value) || 10;
        const btn = event.target;
        btn.disabled = true;
        const origText = btn.innerHTML;
        btn.innerHTML = '⏳ Creating...';
        try {
          const res = await fetch(`${BASE}/pages.json`, {
            method: 'POST', credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ sportId: SPORT_ID, action: 'bulkCreate', count })
          });
          if (res.status === 401) { window.location.href = '/admin/login'; return; }
          if (!res.ok) {
            let msg = 'Failed to create pages';
            try {
              const d = await res.json();
              msg = d.error || 'Failed';
              console.error('[bulkCreate] API error:', d);
              if (d.detail) console.error('[bulkCreate] Stack:', d.detail);
            } catch (e) {
              console.error('[bulkCreate] Non-JSON response:', e);
            }
            btn.disabled = false;
            btn.innerHTML = origText;
            showToast('❌ ' + msg);
            return;
          }
          let data = {};
          try { data = await res.json(); } catch (_) {}
          const actualCount = (data && data.pages) ? data.pages.length : count;
          btn.disabled = false;
          btn.innerHTML = origText;
          closeBulkModal();
          await loadPages();
          showToast(`✅ Created ${actualCount} pages!`);
        } catch(e) {
          console.error('[bulkCreate] Network error:', e);
          btn.disabled = false;
          btn.innerHTML = origText;
          showToast('❌ Network error. Try again.');
        }
      }

      checkAuth();
      loadPages();
    </script>
  </body>
</html>
