---
import Layout from "../layouts/Layout.astro";

const title = "404 - Page Not Found | Methstreams";
const description = "Sorry! The page you are looking for does not exist. Return to the home page to follow the latest matches live on Methstreams.";
---

<Layout title={title} description={description}>
  <div class="flex flex-col items-center justify-center min-h-[60vh] text-center px-4">
    <h1 class="text-9xl font-black bg-gradient-to-r from-blue-400 to-sky-300 bg-clip-text text-transparent mb-4">404</h1>
    <h2 class="text-3xl font-bold theme-text-primary mb-6">Oops! Page Not Found</h2>
    <p class="theme-text-secondary text-lg max-w-md mb-10">
      It seems you followed a broken link or the page has been moved. Don't worry, you can follow all today's matches live via our home page.
    </p>
    <a
      href="/"
      class="px-8 py-4 bg-gradient-to-r from-blue-600 to-blue-500 text-white font-black rounded-xl text-xl transition-all hover:from-blue-500 hover:to-blue-400 hover:scale-105 shadow-xl shadow-blue-500/30"
    >
      Return to Home Page
    </a>
  </div>
</Layout>
