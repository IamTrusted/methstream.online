---
import Layout from "../layouts/Layout.astro";
const title = "Privacy Policy - Methstreams";
const description = "Privacy Policy for Methstreams. We are committed to protecting our users' data.";
---

<Layout title={title} description={description}>
  <div class="max-w-4xl mx-auto px-4 py-16 prose theme-text-primary">
    <h1 class="text-4xl font-black mb-8 bg-gradient-to-r from-blue-400 to-sky-300 bg-clip-text text-transparent">Privacy Policy</h1>
    <p class="text-lg mb-6">
      At <strong>Methstreams</strong>, the privacy of our visitors is one of our top priorities.
    </p>
    <p>
      This page outlines the types of information collected and how it is used. We use cookies to improve user experience and personalize content.
    </p>
  </div>
</Layout>
