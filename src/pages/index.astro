import Layout from "../layouts/Layout.astro";
import slugify from "../utils/slugify";
import translateTeam from "../utils/translateTeams";
import { fetchSports, fetchMatches, ENDPOINTS } from "../utils/api";
import AdBanner from "../components/ads/AdBanner.astro";

interface APIMatch {
    id: string;
    title: string;
    category: string;
    date: number;
    poster?: string;
    popular: boolean;
    teams?: {
        home?: {
            name: string;
            badge: string;
        },
        away?: {
            name: string;
            badge: string;
        }
    };
    sources: {
        source: string;
        id: string;
    }[];
}

interface Sport {
    id: string;
    name: string;
}

// Fallback sports data with sample matches if API fails
const now = Date.now();
const fallbackSports = [
  {
    sport_id: 'football',
    sport: 'Soccer',
    league_schedule: [
      { id: '1', title: 'Real Madrid vs Barcelona', category: 'football', date: now, popular: true },
      { id: '2', title: 'Manchester United vs Liverpool', category: 'football', date: now + 3600000, popular: true },
      { id: '3', title: 'Bayern Munich vs Borussia Dortmund', category: 'football', date: now + 7200000, popular: true },
      { id: '4', title: 'Juventus vs Inter Milan', category: 'football', date: now + 86400000, popular: true }
    ]
  },
  {
    sport_id: 'basketball',
    sport: 'Basketball',
    league_schedule: [
      { id: '6', title: 'Celtics vs Heat', category: 'basketball', date: now, popular: true },
      { id: '7', title: 'Bulls vs Knicks', category: 'basketball', date: now + 86400000, popular: true }
    ]
  },
  {
    sport_id: 'cricket',
    sport: 'Cricket',
    league_schedule: [
      { id: '17', title: 'Australia vs England', category: 'cricket', date: now, popular: true },
      { id: '18', title: 'South Africa vs India', category: 'cricket', date: now + 86400000, popular: true }
    ]
  },
  {
    sport_id: 'american-football',
    sport: 'American Football',
    league_schedule: [
      { id: '26', title: 'Ravens vs Bengals', category: 'american-football', date: now, popular: true },
      { id: '29', title: 'Seahawks vs Cardinals', category: 'american-football', date: now + 86400000, popular: true }
    ]
  }
];

let allSports = [];

try {
  const [sportsData, matchesData] = await Promise.all([
    fetchSports(),
    fetchMatches('all') // Use 'all' or 'today' as needed
  ]);

  if (sportsData.length > 0) {
    // Filter matches for next 7 days (plus 24/7 channels like Rally TV with date 0)
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    const nextWeek = new Date(today);
    nextWeek.setDate(today.getDate() + 7); // Show matches for next 7 days

    const filteredMatches = matchesData.filter(m => {
      // 24/7 channels like Rally TV have date: 0 or undefined -> ALWAYS keep them
      if (!m.date || m.date === 0) return true;
      const matchDate = new Date(m.date);
      return matchDate >= today && matchDate < nextWeek;
    });


    // Extract LIVE matches (including 24/7 live channels)
    const liveMatches = matchesData.filter(m => {
      if (!m.date || m.date === 0) return true; // 24/7 channels are continuously live
      const matchTime = m.date;
      const nowTime = Date.now();
      // Match is live if it started in the last 2.5 hours and is not in the future
      return nowTime >= matchTime && nowTime <= (matchTime + 9000000); 
    });

    // Group matches by category
    const groupedMatches = sportsData.map(sport => {
      // For buttons grid: check if there are ANY matches for this sport in the full list
      const hasAnyMatchesInAPI = matchesData.some(m => m.category === sport.id);
      
      // For matches list: only the filtered ones
      const sportMatches = filteredMatches.filter(m => m.category === sport.id);
      
      return {
        sport: sport.name,
        sport_id: sport.id,
        league_schedule: sportMatches,
        isVisibleInGrid: hasAnyMatchesInAPI
      };
    }).filter(s => s.isVisibleInGrid);

    // Create a special LIVE category if there are live matches
    const liveCategory = {
      sport: 'LIVE',
      sport_id: 'live',
      league_schedule: liveMatches,
      isVisibleInGrid: liveMatches.length > 0
    };

    // Move Football to the top, then others, then LIVE at the end
    const footballIdx = groupedMatches.findIndex(s => s.sport_id === 'football');
    let finalSports = [];
    
    if (footballIdx > -1) {
      const football = groupedMatches.splice(footballIdx, 1)[0];
      finalSports.push(football);
    }

    // Add remaining sports
    finalSports = [...finalSports, ...groupedMatches];

    // Add LIVE at the end if it exists
    if (liveCategory.isVisibleInGrid) {
      finalSports.push(liveCategory);
    }
    
    allSports = finalSports;
  }
} catch (error) {
  console.error("Error fetching schedule:", error);
}

// If no sports from API, use fallback
if (allSports.length === 0) {
  console.log("Using fallback sports data");
  allSports = fallbackSports;
} else {
  console.log("Using API sports data");
}

const SHOW_ADS = import.meta.env.SHOW_ADS === "true";

const sportIcons = {
