<script is:inline>
  const searchInput = document.getElementById('match-search');
  const sportSections = document.querySelectorAll('.sport-section');
  const noMatchesMsg = document.getElementById('no-matches-found');
  const sportBtns = document.querySelectorAll('.sport-filter-btn');

  // Initialize: show ALL sport sections
  sportSections.forEach((section) => {
    section.classList.remove('hidden');
  });

  // Handle sport filter button clicks
  sportBtns.forEach((btn, index) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault(); // Prevent default anchor click
      
      // Remove active state from all buttons
      sportBtns.forEach(b => {
        b.classList.remove('active');
      });
      
      // Add active state to clicked button
      btn.classList.add('active');
      
      // Scroll to the clicked sport's section (keep ALL sports still visible)
      sportSections[index].scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      const searchTerm = e.target.value.toLowerCase().trim();
      let hasAnyMatches = false;

      sportSections.forEach(section => {
        const cards = section.querySelectorAll('.match-card-premium');
        let hasMatchesInSection = false;

        cards.forEach(card => {
          const searchData = card.getAttribute('data-search');
          if (searchData.includes(searchTerm)) {
            card.classList.remove('hidden');
            card.classList.add('grid');
            hasMatchesInSection = true;
            hasAnyMatches = true;
          } else {
            card.classList.remove('grid');
            card.classList.add('hidden');
          }
        });

        if (hasMatchesInSection) {
          section.classList.remove('hidden');
        } else {
          section.classList.add('hidden');
        }
      });

      if (hasAnyMatches) {
        noMatchesMsg.classList.add('hidden');
      } else {
        noMatchesMsg.classList.remove('hidden');
      }
    });
  }

  // FAQ Accordion
  const faqQuestions = document.querySelectorAll('.faq-question');
  faqQuestions.forEach(question => {
    question.addEventListener('click', () => {
      const answer = question.nextElementSibling;
      const icon = question.querySelector('.faq-icon');
      
      // Toggle visibility
      const isHidden = answer.classList.contains('hidden');
      
      // Close all other FAQs first (optional but nice)
      document.querySelectorAll('.faq-answer').forEach(ans => ans.classList.add('hidden'));
      document.querySelectorAll('.faq-icon').forEach(i => i.style.transform = 'rotate(0deg)');
      
      if (isHidden) {
        answer.classList.remove('hidden');
        icon.style.transform = 'rotate(180deg)';
      }
    });
  });

  // Match Status & Countdown Timer
  function updateMatchStatuses() {
    const containers = document.querySelectorAll('.match-status-container');
    const now = new Date().getTime();

    containers.forEach(container => {
      const timestamp = parseInt(container.getAttribute('data-timestamp'));
      const statusText = container.querySelector('.status-text');
      const diff = timestamp - now;

      if (diff <= 0) {
        // Match is LIVE
        if (!statusText.classList.contains('is-live')) {
          statusText.innerHTML = `<span class="flex items-center gap-1.5 text-red-500"><span class="w-1.5 h-1.5 bg-red-500 rounded-full animate-pulse"></span>LIVE</span>`;
          statusText.classList.add('is-live');
          statusText.classList.remove('theme-text-secondary');
          statusText.parentElement.parentElement.parentElement.classList.add('border-red-500/30');
        }
      } else {
        // Match is Upcoming - Show Countdown
        const hours = Math.floor(diff / (1000 * 60 * 60));
        const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((diff % (1000 * 60)) / 1000);

        let countdownStr = '';
        if (hours > 0) countdownStr += `${hours}h `;
        countdownStr += `${minutes}m ${seconds}s`;
        
        statusText.innerHTML = `<span class="text-brand font-bold">Starts in: ${countdownStr}</span>`;
      }
    });
  }

  // Initial call and set interval
  updateMatchStatuses();
  setInterval(updateMatchStatuses, 1000);
</script>
