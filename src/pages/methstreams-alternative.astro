---
import Layout from "../layouts/Layout.astro";
import slugify from "../utils/slugify";
import { fetchSports, fetchMatches, ENDPOINTS } from "../utils/api";

export const prerender = false;

interface APIMatch {
    id: string;
    title: string;
    category: string;
    date: number;
    poster?: string;
    popular: boolean;
    teams?: {
        home?: {
            name: string;
            badge: string;
        },
        away?: {
            name: string;
            badge: string;
        }
    };
    sources: {
        source: string;
        id: string;
    }[];
}

interface Sport {
    id: string;
    name: string;
}

let allSports: { sport: string; sport_id: string; league_schedule: APIMatch[] }[] = [];
try {
  const [sportsData, matchesData] = await Promise.all([
    fetchSports(),
    fetchMatches('all')
  ]);

  if (sportsData.length > 0) {
    // Filter matches for Today and Tomorrow only
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    const dayAfterTomorrow = new Date(today);
    dayAfterTomorrow.setDate(today.getDate() + 2); // This covers today and tomorrow

    const filteredMatches = matchesData.filter(m => {
      const matchDate = new Date(m.date);
      return matchDate >= today && matchDate < dayAfterTomorrow;
    });

    // Group matches by category
    const groupedMatches = sportsData.map(sport => {
      const hasAnyMatchesInAPI = matchesData.some(m => m.category === sport.id);
      const sportMatches = filteredMatches.filter(m => m.category === sport.id);
      return {
        sport: sport.name,
        sport_id: sport.id,
        league_schedule: sportMatches,
        isVisibleInGrid: hasAnyMatchesInAPI
      };
    }).filter(s => s.isVisibleInGrid);

    // Move Football to the top
    const footballIdx = groupedMatches.findIndex(s => s.sport_id === 'football');
    if (footballIdx > -1) {
      const football = groupedMatches.splice(footballIdx, 1)[0];
      allSports = [football, ...groupedMatches];
    } else {
      allSports = groupedMatches;
    }
  }
} catch (error) {
  console.error("Error fetching schedule for landing page:", error);
}

const sportIcons: { [key: string]: string } = {
  football: "⚽",
  basketball: "🏀",
  baseball: "⚾",
  hockey: "🏒",
  mma: "🥋",
  boxing: "🥊",
  tennis: "🎾",
  cricket: "🏏",
  rugby: "🏉",
  volleyball: "🏐",
  motorsports: "🏎️",
  fight: "🥊",
  american: "🏈",
  "american-football": "🏈",
  golf: "⛳",
  snooker: "🎱",
  darts: "🎯"
};

const formatDateEnglish = (date: Date) => {
  const days = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
  const months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
  
  const dayName = days[date.getDay()];
  const day = date.getDate().toString().padStart(2, '0');
  const monthName = months[date.getMonth()];
  const hours = date.getHours().toString().padStart(2, '0');
  const minutes = date.getMinutes().toString().padStart(2, '0');
  
  return `${dayName}, ${monthName} ${day} - ${hours}:${minutes}`;
};

const title = "Methstreams Official - Best Buffstreams & Crackstreams";
const description = "Watch Methstreams official live streams in HD. The best Buffstreams & Crackstreams alternative for free NFL, NBA, UFC, Premier League & MLB broadcasts.";
const keywords = "methstreams, methstreams alternative, buffstreams, crackstreams, best buffstreams alternative, best crackstreams alternative, free live sports streaming, watch sports hd";
