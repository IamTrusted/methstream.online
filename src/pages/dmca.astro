---
import Layout from "../layouts/Layout.astro";
const title = "DMCA - Methstreams";
const description = "Digital Millennium Copyright Act (DMCA) Policy for Methstreams. We respect intellectual property rights.";
---

<Layout title={title} description={description}>
  <div class="max-w-4xl mx-auto px-4 py-16 prose theme-text-primary">
    <h1 class="text-4xl font-black mb-8 bg-gradient-to-r from-blue-400 to-sky-300 bg-clip-text text-transparent">DMCA - Copyright Policy</h1>
    <p class="text-lg mb-6">
      At <strong>Methstreams</strong>, we respect the intellectual property rights of others and expect our users to do the same.
    </p>
    <p>
      If you believe that your work has been copied in a way that constitutes copyright infringement, please contact us via our "Contact Us" page.
    </p>
  </div>
</Layout>
