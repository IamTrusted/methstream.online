      Updated guides for MethStreams, Streameast and Footybite with football, NFL, NBA and UFC coverage for 2026.
    </p>

    <div class="grid gap-8">
      {posts.map(post => (
        <article class="theme-card p-6 sm:p-8 rounded-2xl border border-[var(--border-color)] hover:border-brand/50 transition-all group shadow-lg">
          <div class="flex items-center gap-4 mb-4">
            <span class="px-3 py-1 rounded-full bg-brand/10 text-brand text-xs font-bold uppercase tracking-wider">
              {post.category}
            </span>
            <time class="text-xs theme-text-secondary">{post.date}</time>
          </div>
          <a href={`/blog/${post.slug}`} class="block">
            <h2 class="text-2xl sm:text-3xl font-black theme-text-primary mb-4 group-hover:text-brand transition-colors tracking-tight italic uppercase">
              {post.title}
            </h2>
          </a>
          <p class="theme-text-secondary leading-relaxed mb-6">
            {post.description}
          </p>
          <a href={`/blog/${post.slug}`} class="inline-flex items-center gap-2 text-brand font-bold uppercase text-sm tracking-widest hover:gap-3 transition-all">
            Read More
