---

<Layout title={post.title} description={post.description}>
  <div class="min-h-screen pt-8 pb-12 px-4">
    <div class="max-w-4xl mx-auto">
      <!-- Back to Blog -->
      <a href="/blog" class="inline-flex items-center gap-2 theme-text-secondary hover:text-[#22c55e] mb-8 transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
        Back to Blog
      </a>

      <!-- Article -->
      <article class="theme-card rounded-2xl p-8 shadow-2xl border border-[var(--border-color)]">
        <!-- Category Badge -->
        <span class="inline-block px-4 py-1 bg-[#22c55e]/20 text-[#22c55e] text-sm font-bold rounded-full mb-4">
          {post.category}
        </span>

        <!-- Title -->
        <h1 class="text-3xl sm:text-4xl font-black theme-text-primary mb-4 leading-tight">
          {post.title}
        </h1>

        <!-- Date -->
        <time class="text-sm theme-text-secondary mb-8 block">
          {new Date(post.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>

        <!-- Content -->
        <div class="prose prose-invert max-w-none theme-text-primary">
          <Fragment set:html={post.content} />
        </div>
      </article>
    </div>
  </div>
</Layout>

