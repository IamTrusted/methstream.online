const description = "Need a Crackstreams alternative? Methstreams delivers free live sports streams like Crackstreams & Buffstreams for UFC, NBA, NFL and boxing in 1080p HD.";
const keywords = "crackstreams alternative, methstreams, buffstreams, best crackstreams alternative, free sports streaming, watch live sports free, crackstreams ufc, crackstreams nba";
