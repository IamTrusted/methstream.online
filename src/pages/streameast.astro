    <div class="theme-card p-10 rounded-3xl border border-white/10 bg-white/5 text-center relative overflow-hidden mb-16">
      <div class="absolute -top-24 -left-24 w-48 h-48 bg-brand/5 rounded-full blur-[60px] pointer-events-none"></div>
      <div class="absolute -bottom-24 -right-24 w-48 h-48 bg-brand/5 rounded-full blur-[60px] pointer-events-none"></div>
      
      <h2 class="text-3xl sm:text-4xl font-black uppercase mb-4 theme-text-primary italic">Watch Football Now</h2>
      <p class="theme-text-secondary text-base sm:text-lg max-w-2xl mx-auto mb-8 leading-relaxed">
        Browse today's schedule and find your match. HD streams ready with backup options.
      </p>
      
      <a href="/" class="inline-block px-10 py-5 bg-brand text-black font-black rounded-xl text-xl transition-all hover:bg-brand/90 hover:scale-105 shadow-xl hover:shadow-brand/20">
        View All Sports
      </a>
    </div>
  </div>

  <!-- Client-side script for FAQ Accordion & Countdown -->
  <script is:inline>
    // FAQ Accordion
    const questions = document.querySelectorAll('.faq-question');
    questions.forEach(q => {
      q.addEventListener('click', () => {
        const item = q.parentElement;
        const answer = item.querySelector('.faq-answer');
        const icon = q.querySelector('.faq-icon');
        const isOpen = item.classList.contains('active');

        // Close all other accordion items
        document.querySelectorAll('.faq-item').forEach(otherItem => {
          otherItem.classList.remove('active');
          const otherAnswer = otherItem.querySelector('.faq-answer');
          const otherIcon = otherItem.querySelector('.faq-icon');
          if (otherAnswer) otherAnswer.style.maxHeight = '0px';
          if (otherIcon) otherIcon.style.transform = 'rotate(0deg)';
        });

        // Toggle clicked item
        if (!isOpen) {
          item.classList.add('active');
          answer.style.maxHeight = answer.scrollHeight + 'px';
          icon.style.transform = 'rotate(180deg)';
        }
      });
    });

    // Match Status & Countdown Timer
    function updateMatchStatuses() {
      const containers = document.querySelectorAll('.match-status-container');
      const now = new Date().getTime();

      containers.forEach(container => {
        const timestamp = parseInt(container.getAttribute('data-timestamp'));
        const statusText = container.querySelector('.status-text');
        const diff = timestamp - now;

        if (diff <= 0) {
          // Match is LIVE
          if (!statusText.classList.contains('is-live')) {
            statusText.innerHTML = `<span class="flex items-center gap-1.5 text-red-500"><span class="w-1.5 h-1.5 bg-red-500 rounded-full animate-pulse"></span>LIVE</span>`;
            statusText.classList.add('is-live');
            statusText.classList.remove('theme-text-secondary');
            statusText.parentElement.parentElement.parentElement.classList.add('border-red-500/30');
          }
        } else {
          // Match is Upcoming - Show Countdown
          const hours = Math.floor(diff / (1000 * 60 * 60));
          const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
          const seconds = Math.floor((diff % (1000 * 60)) / 1000);

          let countdownStr = '';
          if (hours > 0) countdownStr += `${hours}h `;
          countdownStr += `${minutes}m ${seconds}s`;
          
          statusText.innerHTML = `<span class="text-brand font-bold">Starts in: ${countdownStr}</span>`;
        }
      });
    }

    // Initial call and set interval
    updateMatchStatuses();
    setInterval(updateMatchStatuses, 1000);
  </script>
</Layout>

