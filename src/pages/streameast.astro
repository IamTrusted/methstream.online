---
import Layout from "../layouts/Layout.astro";
import slugify from "../utils/slugify";
import { fetchSports, fetchMatches, ENDPOINTS } from "../utils/api";

export const prerender = false;

interface APIMatch {
    id: string;
    title: string;
    category: string;
    date: number;
    poster?: string;
    popular: boolean;
    teams?: {
        home?: {
            name: string;
            badge: string;
        },
        away?: {
            name: string;
            badge: string;
        }
    };
    sources: {
        source: string;
        id: string;
    }[];
}

interface Sport {
    id: string;
    name: string;
}

const now = Date.now();
const fallbackFootballMatches = [
  { id: 'r1', title: 'Real Madrid vs Barcelona', category: 'football', date: now - 86400000, popular: true },
  { id: 'r2', title: 'Manchester United vs Liverpool', category: 'football', date: now, popular: true },
  { id: 'r3', title: 'Bayern Munich vs Borussia Dortmund', category: 'football', date: now + 3600000, popular: true },
  { id: 'r4', title: 'Chelsea vs Arsenal', category: 'football', date: now + 7200000, popular: true },
  { id: 'r5', title: 'PSG vs Marseille', category: 'football', date: now + 86400000, popular: true },
  { id: 'r6', title: 'Juventus vs Inter Milan', category: 'football', date: now + 93600000, popular: true }
];

let allSports: { sport: string; sport_id: string; league_schedule: APIMatch[] }[] = [];
try {
  const [sportsData, matchesData] = await Promise.all([
    fetchSports(),
    fetchMatches('all')
  ]);

  if (sportsData.length > 0) {
    // Filter matches for Today and Tomorrow only
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    const dayAfterTomorrow = new Date(today);
    dayAfterTomorrow.setDate(today.getDate() + 2); // This covers today and tomorrow

    const filteredMatches = matchesData.filter(m => {
      const matchDate = new Date(m.date);
      return matchDate >= today && matchDate < dayAfterTomorrow;
    });

    // Group matches by category
    const groupedMatches = sportsData.map(sport => {
      const hasAnyMatchesInAPI = matchesData.some(m => m.category === sport.id);
      const sportMatches = filteredMatches.filter(m => m.category === sport.id);
      return {
        sport: sport.name,
        sport_id: sport.id,
        league_schedule: sportMatches,
        isVisibleInGrid: hasAnyMatchesInAPI
      };
    }).filter(s => s.isVisibleInGrid);

    // Only keep Football for Streameast page
    allSports = groupedMatches.filter(s => s.sport_id === 'football');
  }
  
  // Fallback if no matches from API
  if (allSports.length === 0 || allSports[0].league_schedule.length === 0) {
    allSports = [{
      sport: 'Football',
      sport_id: 'football',
      league_schedule: fallbackFootballMatches
    }];
  }
} catch (error) {
  console.error("Error fetching schedule for streameast landing page:", error);
  // Use fallback on error
  allSports = [{
    sport: 'Football',
    sport_id: 'football',
    league_schedule: fallbackFootballMatches
  }];
}

const sportIcons: { [key: string]: string } = {
  football: "⚽",
  basketball: "🏀",
  baseball: "⚾",
  hockey: "🏒",
  mma: "🥋",
  boxing: "🥊",
  tennis: "🎾",
  cricket: "🏏",
  rugby: "🏉",
  volleyball: "🏐",
  motorsports: "🏎️",
  fight: "🥊",
  american: "🏈",
  "american-football": "🏈",
  golf: "⛳",
  snooker: "🎱",
  darts: "🎯"
};

const formatDateEnglish = (date: Date) => {
  const days = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
  const months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
  
  const dayName = days[date.getDay()];
  const day = date.getDate().toString().padStart(2, '0');
  const monthName = months[date.getMonth()];
  const hours = date.getHours().toString().padStart(2, '0');
  const minutes = date.getMinutes().toString().padStart(2, '0');
  
  return `${dayName}, ${monthName} ${day} - ${hours}:${minutes}`;
};

const title = "StreamEast Alternative - Methstreams Live Sports HD";
const description = "StreamEast alternative: Methstreams brings free live sports feeds like Buffstreams & Crackstreams. Stream Premier League, La Liga, NFL, NBA & UFC in HD.";
const keywords = "streameast, streameast alternative, methstreams, buffstreams, crackstreams, free soccer streams, watch sports hd free, live football stream";
---

